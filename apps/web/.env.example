# Copy to `.env.local` (already gitignored):  cp apps/web/.env.example apps/web/.env.local

# Where the Node API lives. Server-side only — deliberately NOT prefixed with
# NEXT_PUBLIC_, because the browser must never call the API directly. Every request
# originates from the Next.js server, which attaches the access token it reads from
# an httpOnly cookie.
API_URL="http://localhost:4000/api/v1"

# Cookies are marked Secure in production. Left off in development so they work over
# plain http://localhost.
NODE_ENV=development
