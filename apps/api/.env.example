# Copy to `.env` (already gitignored):  cp apps/api/.env.example apps/api/.env
#
# Every variable here is parsed and validated by src/config/env.ts at boot.
# A missing or malformed value stops the process with a readable message rather
# than failing later inside a request.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# SQLite lives as a file next to the schema. `npm run db:seed` creates and fills it.
DATABASE_URL="file:./prisma/dev.db"

# Signs the short-lived access tokens. Minimum 32 characters, enforced at boot.
#
# The value below is fine for local development and is committed on purpose so the
# project runs immediately after cloning. GENERATE A NEW ONE FOR ANY REAL DEPLOYMENT:
#   openssl rand -base64 48
JWT_SECRET="dev-only-secret-do-not-use-in-production-8f3a1c9e2b7d4056"

# Access tokens stay short so a leaked one expires before it is useful; the refresh
# token is long-lived but rotates on every use and is stored hashed.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# The single origin permitted by CORS. The browser never calls this API directly —
# requests come from the Next.js server — so this should not need to grow.
WEB_ORIGIN="http://localhost:3000"
